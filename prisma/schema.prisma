// SQLite has no native enums or JSON columns, so enum-like fields are strings
// (validated in application code) and JSON payloads are serialized strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------- Platform core ----------

model User {
  id    String @id
  name  String
  email String @unique
  /// Comma-separated roles: reviewer | approver | admin
  roles String

  approvalsRequested ApprovalRequest[] @relation("ApprovalRequestedBy")
  approvalsApproved  ApprovalRequest[] @relation("ApprovalApprovedBy")
  approvalsRejected  ApprovalRequest[] @relation("ApprovalRejectedBy")
  refundsRequested   Refund[]
  kycAssigned        KycCase[]
}

/// Append-only. Database triggers (see migrations) reject UPDATE and DELETE.
/// actorId is intentionally not a foreign key so audit history survives user changes.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  before     String?
  after      String?
  timestamp  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([actorId])
  @@index([timestamp])
}

/// Generic maker-checker request. `payload` is app-defined JSON.
model ApprovalRequest {
  id            String    @id @default(cuid())
  entityType    String
  entityId      String
  payload       String
  /// pending | approved | rejected
  status        String    @default("pending")
  requestedById String
  requestedBy   User      @relation("ApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?     @relation("ApprovalApprovedBy", fields: [approvedById], references: [id])
  rejectedById  String?
  rejectedBy    User?     @relation("ApprovalRejectedBy", fields: [rejectedById], references: [id])
  decisionNote  String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([entityType, entityId])
  @@index([status])
}

// ---------- App: Refunds ----------

/// Mirror of the payment processor's charges (stubbed Stripe). The source of truth for what can be refunded.
model Charge {
  /// Processor charge id, e.g. ch_3PqRsT9uVwXyZ1
  id                  String   @id
  customerName        String
  customerEmail       String
  description         String
  amountCents         Int
  currency            String   @default("usd")
  /// Sum of executed refunds.
  amountRefundedCents Int      @default(0)
  /// Held by refunds awaiting approval or in flight, so concurrent requests can't over-refund.
  amountPendingCents  Int      @default(0)
  createdAt           DateTime @default(now())
  refunds             Refund[]

  @@index([customerEmail])
}

model Refund {
  id                String   @id @default(cuid())
  /// Copied from the charge when the refund is requested.
  customerName      String
  /// Copied from the charge when the refund is requested.
  customerEmail     String
  chargeId          String
  charge            Charge   @relation(fields: [chargeId], references: [id])
  amountCents       Int
  currency          String   @default("usd")
  /// Reason code: duplicate | fraudulent | requested_by_customer | service_not_delivered | goodwill
  reason            String
  /// Internal note from the requester (not sent to the processor). Required for reason "fraudulent".
  note              String?
  /// processing | pending_approval | executed | rejected | failed
  status            String
  requestedById     String
  requestedBy       User     @relation(fields: [requestedById], references: [id])
  approvalRequestId String?
  /// Approval rules that triggered, comma-separated: single_amount | charge_cumulative | requester_daily
  approvalRule      String?
  /// Human-readable trigger snapshot at request time, e.g. "Needs approval: cumulative refunds on this charge exceed $500.00 (...)"
  approvalReason    String?
  providerRefundId  String?
  /// Client-supplied Idempotency-Key; also sent to the payments provider.
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([chargeId])
}

// ---------- App: KYC review queue ----------

/// US Customer Identification Program (31 CFR 1020.220): name, DOB, residential address, and an
/// identification number (TIN for US persons; passport or other government ID + issuing country otherwise).
/// Cases are never deleted: a DB trigger rejects DELETE (see migrations), and there is no delete route.
model KycCase {
  id             String    @id @default(cuid())
  applicantName  String
  email          String
  /// PII: masked for non-approvers. YYYY-MM-DD
  dateOfBirth    String
  /// PII (street + postal code masked for non-approvers)
  addressLine1   String
  addressLine2   String?
  city           String
  region         String
  postalCode     String
  /// Country of residence (ISO 3166-1 alpha-2)
  country        String
  isUSPerson     Boolean
  /// ssn (US persons only) | passport | other_gov_id (non-US persons only)
  idType         String
  /// PII: never return unmasked to non-approvers (see lib/apps/kyc/present.ts)
  idNumber       String
  /// Issuing country for passport / other_gov_id
  idCountry      String?
  /// Passport expiry, YYYY-MM-DD
  idExpiry       String?
  /// submitted | in_review | approved | rejected | escalated | pending_rejection
  status         String    @default("submitted")
  assignedToId   String?
  assignedTo     User?     @relation(fields: [assignedToId], references: [id])
  escalatedById  String?
  vendorCheckId  String?
  /// pass | fail | needs_review
  identityCheck  String?
  documentCheck  String?
  sanctionsCheck String?
  pepCheck       String?
  /// 0-100; Low < 40, Medium 40-69, High >= 70
  riskScore      Int?
  /// Latest decision (approve/reject/escalate): reason code + note, who and when
  decisionReason String?
  decisionNote   String?
  decidedById    String?
  decidedAt      DateTime?
  approvalRequestId String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
}
